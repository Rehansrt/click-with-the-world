{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/flags/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^click-with-the-world\\.vercel\\.app$" }],
      "destination": "https://www.clickwiththeworld.fun/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path((?!ads\\.txt$).*)",
      "has": [{ "type": "host", "value": "^clickwiththeworld\\.fun$" }],
      "destination": "https://www.clickwiththeworld.fun/:path",
      "statusCode": 301
    }
  ]
}
