{
  "rules": {
    ".write": false,

    "stats": {
      ".read": true,
      "total": {
        ".read": true,
        ".write": "newData.exists()",
        ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
      },
      "countries": {
        "$country": {
          ".read": true,
          ".write": "newData.exists()",
          ".validate": "$country.matches(/^[A-Z]{2}$/) && newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
        }
      },
      "daily": {
        "$date": {
          ".read": true,
          ".write": "newData.exists()",
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1 && newData.parent().parent().parent().child('stats/total').val() == (root.child('stats/total').exists() ? root.child('stats/total').val() : 0) + 1"
        }
      },
      "milestones": {
          // TEMP-TEST-KEY — remove after verification
          "100": {
            ".write": "newData.exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000 && newData.parent().parent().parent().child('stats/total').val() >= 100"
          },
          "1000": {
            ".write": "newData.exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000 && newData.parent().parent().parent().child('stats/total').val() >= 1000"
          },
          "10000": {
            ".write": "newData.exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000 && newData.parent().parent().parent().child('stats/total').val() >= 10000"
          },
          "100000": {
            ".write": "newData.exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000 && newData.parent().parent().parent().child('stats/total').val() >= 100000"
          },
          "500000": {
            ".write": "newData.exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000 && newData.parent().parent().parent().child('stats/total').val() >= 500000"
          },
          "1000000": {
            ".write": "newData.exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000 && newData.parent().parent().parent().child('stats/total').val() >= 1000000"
          },
          "5000000": {
            ".write": "newData.exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000 && newData.parent().parent().parent().child('stats/total').val() >= 5000000"
          },
          "10000000": {
            ".write": "newData.exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000 && newData.parent().parent().parent().child('stats/total').val() >= 10000000"
          },
          "100000000": {
            ".write": "newData.exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000 && newData.parent().parent().parent().child('stats/total').val() >= 100000000"
          }
      }
    },

    "recentClicks": {
      ".read": true,
      "latest": {
        ".read": true,
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['country', 'ts'])",
        "country": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
        },
        "ts": {
          ".validate": "newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      },
      "feed": {
        "$slot": {
          ".read": true,
          ".write": "newData.exists()",
          ".validate": "$slot.matches(/^[0-5]$/) && newData.hasChildren(['c', 't']) && newData.parent().parent().parent().child('stats/total').val() == (root.child('stats/total').exists() ? root.child('stats/total').val() : 0) + 1",
          "c": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "clientCooldowns": {
      "$clientId": {
        ".read": false,
        ".write": "newData.exists()",
        ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() > data.val() + 800)"
      }
    },

    "appcheckLogs": {
      ".read": false,
      "$logId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['code', 'message', 'userAgent', 'path', 'timestamp'])",
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "userAgent": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "path": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
