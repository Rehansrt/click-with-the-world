{
  "rules": {
    ".write": false,

    "stats": {
      ".read": true,
      "total": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
      },
      "countries": {
        "$country": {
          ".read": true,
          ".write": true,
          ".validate": "$country.matches(/^[A-Z]{2}$/) && newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1"
        }
      }
    },

    "recentClicks": {
      ".read": true,
      "latest": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['country', 'ts'])",
        "country": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
        },
        "ts": {
          ".validate": "newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "clientCooldowns": {
      "$clientId": {
        ".read": false,
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() > data.val() + 800)"
      }
    },

    "appcheckLogs": {
      ".read": false,
      "$logId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['code', 'message', 'userAgent', 'path', 'timestamp'])",
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "userAgent": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "path": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
